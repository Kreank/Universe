    "deuterium_synth":   { "cost": { "metal": 225, "crystal": 75,  "deuterium": 0 },   "factor": 1.5, "prod_base": 10, "prod_growth": 1.1, "energy_base": 20, "energy_growth": 1.1 },
    "solar_plant":       { "cost": { "metal": 75,  "crystal": 30,  "deuterium": 0 },   "factor": 1.5, "energy_prod_base": 20, "energy_prod_growth": 1.1 },
    "fusion_reactor":    { "cost": { "metal": 900, "crystal": 360, "deuterium": 180 }, "factor": 1.8, "energy_prod_base": 30 },
    "robot_factory":     { "cost": { "metal": 400, "crystal": 120, "deuterium": 200 }, "factor": 2.0 },
    "shipyard":          { "cost": { "metal": 400, "crystal": 200, "deuterium": 100 }, "factor": 2.0 },
    "research_lab":      { "cost": { "metal": 200, "crystal": 400, "deuterium": 200 }, "factor": 2.0 },
    "metal_storage":     { "cost": { "metal": 1000,"crystal": 0,   "deuterium": 0 },   "factor": 2.0 },
    "crystal_storage":   { "cost": { "metal": 1000,"crystal": 500, "deuterium": 0 },   "factor": 2.0 },
    "deuterium_tank":    { "cost": { "metal": 1000,"crystal": 1000,"deuterium": 0 },   "factor": 2.0 },
    "command_academy":   { "cost": { "metal": 1000,"crystal": 1000,"deuterium": 500 }, "factor": 2.0, "_note": "USP: bildet Commander aus" },
    "command_center":    { "cost": { "metal": 5000,"crystal": 3000,"deuterium": 1000 },"factor": 2.0, "_note": "USP: erhoeht Span-of-Control" }
  },

  "storage": {
    "_formula": "5000 * floor(2.5 * e^(20*lvl/33))",
    "base": 5000,
    "starting_capacity": 10000
  },

  "build_time": {
    "_formula_buildings": "hours = (metal + crystal) / (2500 * (1 + robot_factory_lvl) * 2^nanite_lvl * speed)",
    "_formula_ships": "hours = (metal + crystal) / (2500 * (1 + shipyard_lvl) * speed)",
    "divisor": 2500,
    "min_seconds": 1
  },

  "research": {
    "_formula_time": "hours = (metal + crystal) / (1000 * (1 + lab_lvl) * speed)",
    "_formula_cost": "base * 2^(lvl-1)",
    "divisor": 1000,
    "one_at_a_time": true,
    "techs": {
      "energy_tech":        { "cost": { "metal": 0,    "crystal": 800,  "deuterium": 400 }, "requires": { "research_lab": 1 } },
      "combustion_drive":   { "cost": { "metal": 400,  "crystal": 0,    "deuterium": 600 }, "requires": { "energy_tech": 1 } },
      "impulse_drive":      { "cost": { "metal": 2000, "crystal": 4000, "deuterium": 600 }, "requires": { "energy_tech": 1 } },
      "spy_tech":           { "cost": { "metal": 200,  "crystal": 1000, "deuterium": 200 }, "requires": { "research_lab": 3 } },
      "computer_tech":      { "cost": { "metal": 0,    "crystal": 400,  "deuterium": 600 }, "requires": { "research_lab": 1 }, "effect": "+1 fleet slot / level" },
      "weapons_tech":       { "cost": { "metal": 800,  "crystal": 200,  "deuterium": 0 },   "requires": { "research_lab": 4 }, "effect": "+10% attack / level" },
      "shield_tech":        { "cost": { "metal": 200,  "crystal": 600,  "deuterium": 0 },   "requires": { "research_lab": 6 }, "effect": "+10% shield / level" },
      "armor_tech":         { "cost": { "metal": 1000, "crystal": 0,    "deuterium": 0 },   "requires": { "research_lab": 2 }, "effect": "+10% hull / level" },
      "command_doctrine":   { "cost": { "metal": 2000, "crystal": 2000, "deuterium": 1000 },"requires": { "research_lab": 3 }, "effect": "+span-of-control (diminishing)" },
      "logistics_tech":     { "cost": { "metal": 1000, "crystal": 1000, "deuterium": 500 }, "requires": { "research_lab": 3 }, "effect": "faster morale recovery, less overstretch penalty" },
      "crew_psychology":    { "cost": { "metal": 500,  "crystal": 1500, "deuterium": 500 }, "requires": { "research_lab": 4 }, "effect": "higher morale ceiling, slower decay" }
    }
  },

  "ships": {
    "_note": "Huelle = (metall+kristall)/10. Werte OGame-nah, fuer Vertical Slice konkret.",
    "light_fighter":    { "cost": { "metal": 3000,  "crystal": 1000, "deuterium": 0 },   "attack": 50,  "shield": 10, "cargo": 50,   "speed": 12500, "fuel": 20,  "rapidfire": {}, "requires": { "combustion_drive": 1 } },
    "heavy_fighter":    { "cost": { "metal": 6000,  "crystal": 4000, "deuterium": 0 },   "attack": 150, "shield": 25, "cargo": 100,  "speed": 10000, "fuel": 75,  "rapidfire": { "small_cargo": 3, "spy_probe": 5 }, "requires": { "impulse_drive": 2, "armor_tech": 2 } },
    "cruiser":          { "cost": { "metal": 20000, "crystal": 7000, "deuterium": 2000 },"attack": 400, "shield": 50, "cargo": 800,  "speed": 15000, "fuel": 300, "rapidfire": { "light_fighter": 6, "spy_probe": 5 }, "requires": { "impulse_drive": 4, "energy_tech": 3 } },
    "small_cargo":      { "cost": { "metal": 2000,  "crystal": 2000, "deuterium": 0 },   "attack": 5,   "shield": 10, "cargo": 5000, "speed": 5000,  "fuel": 10,  "rapidfire": {}, "requires": { "combustion_drive": 2 } },
    "spy_probe":        { "cost": { "metal": 0,     "crystal": 1000, "deuterium": 0 },   "attack": 0,   "shield": 0,  "cargo": 5,    "speed": 100000000, "fuel": 1, "rapidfire": {}, "requires": { "spy_tech": 1, "combustion_drive": 1 } }
  },

  "defenses": {
    "rocket_launcher":  { "cost": { "metal": 2000, "crystal": 0,    "deuterium": 0 }, "attack": 80,  "shield": 20, "rapidfire_against": {} },
    "light_laser":      { "cost": { "metal": 1500, "crystal": 500,  "deuterium": 0 }, "attack": 100, "shield": 25, "rapidfire_against": {} }
  },

  "tech_bonus": {
    "weapons_per_level": 0.10,
    "shield_per_level": 0.10,
    "armor_per_level": 0.10
  },

  "combat": {
    "max_rounds": 6,
    "shield_bounce_ratio": 0.01,
    "explosion_threshold_hull_pct": 0.70,
    "debris_ratio": 0.30,
