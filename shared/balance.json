      "_note": "Distanzklassen (Doku 06). Vereinfacht fuer Vertical Slice.",
      "same_system": 5,
      "same_galaxy_per_system": 95,
      "inter_galaxy": 20000
    },
    "speed_factor": 35000,
    "_speed_note": "flight_seconds = (10 + 3500/speed_pct * sqrt(distance*10/slowest_ship_speed)) / universe_speed"
  },

  "npc": {
    "tick_interval_seconds": 3600,
    "income_per_tick": { "metal": 800, "crystal": 500, "deuterium": 150 },
    "resource_cap": { "metal": 60000, "crystal": 40000, "deuterium": 15000 },
    "rebuild_fraction_per_tick": 0.25,
    "profiles": {
      "defensive":  { "rebuild_defense": 0.6, "reinforce_fleet": 0.2, "growth_cap_mult": 1.0 },
