      "logistics_tech_bonus_per_level": 0.03,
      "survivor_ship_bonus_max": 0.25
    }
  },

  "commander": {
    "morale": {
      "min": 0, "max": 100, "start": 60, "base_target": 50,
      "drift_rate_per_tick": 0.10,
      "_tick_note": "Moral-Drift laeuft als periodischer Job (stuendlich).",
      "bands": [
        { "min": 80, "max": 100, "combat_mod": 0.10,  "label": "hoch",     "effects": ["+10% Angriff/Schild"] },
        { "min": 50, "max": 79,  "combat_mod": 0.0,   "label": "neutral",  "effects": [] },
        { "min": 25, "max": 49,  "combat_mod": -0.10, "label": "niedrig",  "effects": ["-10% Kampfwerte", "gelegentliche Befehlsverzoegerung"] },
        { "min": 0,  "max": 24,  "combat_mod": -0.25, "label": "kritisch", "effects": ["-25% Kampfwerte", "Meuterei-/Ueberlauf-Risiko"] }
      ],
      "deltas": {
        "victory": 8, "defeat": -12, "crushing_victory": 4, "bashing": -10,
        "demand_fulfilled": 6, "demand_ignored": -6, "promotion": 12,
        "shore_leave": 10, "loot_gained": 4
      },
      "neglect": {
        "idle_days_before_decay": 3,
        "decay_per_day": 2.0,
        "_note": "Horten-Bremse: ungenutzte Commander verlieren Moral (kein Sold, GDD §6.3)."
      }
    },
    "ranks": [
      { "key": "cadet",   "label": "Kadett",   "xp_threshold": 0,    "span_contrib": 1, "stat_cap": 1.0, "permadeath_protection": 0.0 },
