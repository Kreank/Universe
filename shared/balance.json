{
  "_meta": {
    "description": "Single Source of Truth fuer alle Balance-Zahlen von Universe. Backend (Python) und Frontend (TS) laden diese Datei. Aenderungen hier wirken ueberall. Werte fuer den Vertical Slice festgelegt (2026-06-06), tunebar.",
    "version": "0.1.0",
    "doc_refs": ["docs/DESIGN_DECISIONS.md", "docs/systems/01-economy-and-buildings.md"]
  },

  "universe": {
    "speed": 7,
    "_speed_note": "Korridor 5-10 (GDD §12). 7 = modern/zugaenglich. Multipliziert Produktion UND Flottentempo.",
    "base_income": { "metal": 30, "crystal": 15, "deuterium": 0 },
    "galaxies": 3,
