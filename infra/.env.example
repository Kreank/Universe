# Universe — Umgebungsvariablen. Kopiere zu `.env` und passe an.
# cp infra/.env.example infra/.env

# --- PostgreSQL ---
POSTGRES_USER=universe
POSTGRES_PASSWORD=universe
POSTGRES_DB=universe
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Ports ---
API_PORT=8000
WEB_PORT=4200
OLLAMA_PORT=11434

# --- Auth ---
# In Produktion durch ein langes, zufaelliges Secret ersetzen!
JWT_SECRET=dev-only-change-me

# --- Ollama (LLM) ---
# Standard: nativer Ollama auf dem Host. Container-Variante via `--profile ollama`
# und OLLAMA_URL=http://ollama:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
